# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Anthropic
ANTHROPIC_API_KEY=

# XRPL Connect — multi-wallet (Xaman, Crossmark, GemWallet, WalletConnect)
# Crossmark + GemWallet need NO config (Chrome extensions detected at runtime).
# Xaman needs an API key (mobile QR flow):
#   https://apps.xumm.dev/  → Developer Console → New Application
NUXT_PUBLIC_XAMAN_API_KEY=
# WalletConnect is OPTIONAL — if blank, the WalletConnect option simply
# won't show in the connector modal. Project ID from:
#   https://cloud.walletconnect.com
NUXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Network: mainnet | testnet | devnet (defaults to mainnet if unset)
NUXT_PUBLIC_XRPL_NETWORK=mainnet
